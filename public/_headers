# Security headers — applied to all responses served from /public by Cloudflare Pages.
# Mirrors the Cloudflare Pages _headers format: https://developers.cloudflare.com/pages/configuration/headers/

# Default: apply security headers to every response, then per-path overrides below.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP fix 2: added https://fonts.gstatic.com to connect-src.
  # The Workbox service worker fetches font files via fetch() for caching,
  # which triggers connect-src (not font-src). fonts.gstatic.com is on a
  # different domain than *.googleapis.com, so it wasn't covered by the
  # existing connect-src wildcard.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://apis.google.com https://*.googleapis.com https://fonts.gstatic.com https://fonts.googleapis.com wss://*.firebaseio.com https://rq.tarekhamada875.workers.dev; frame-src https://*.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self' blob:

# HTML must never be cached (PWA shell) — override the immutable cache rule below.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

# Fingerprinted assets — safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
