# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT: Optional JSON key for Firebase Admin SDK server access.
FIREBASE_SERVICE_ACCOUNT=""

# VITE_BACKEND_API_URL: Optional absolute URL of the API backend for decoupled frontend deployments.
# Production uses the Railway API at https://rq-production-af02.up.railway.app; set
# this variable in Cloudflare Pages to override it for a preview or migration.
VITE_BACKEND_API_URL=""

# Privileged operator MCP. Keep this secret only in Railway variables; never commit it.
# MCP_OPERATOR_TOKEN must be a long random value and is required for /mcp and operator API calls.
MCP_OPERATOR_TOKEN=""
# Optional when the MCP process is separate from the API process.
MCP_BACKEND_URL="http://127.0.0.1:8080"
