# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT: Optional JSON key for Firebase Admin SDK server access.
FIREBASE_SERVICE_ACCOUNT=""

# VITE_BACKEND_API_URL: Optional absolute URL of the Cloudflare Worker API.
VITE_BACKEND_API_URL=""

# Local UI fixture mode is opt-in and must never be enabled for production.
VITE_RQ_USE_EMULATORS="false"
VITE_RQ_EMULATOR_PROJECT_ID="demo-rq-ui-fixtures"
VITE_RQ_EMULATOR_HOST="127.0.0.1"
VITE_RQ_AUTH_EMULATOR_PORT="9099"
VITE_RQ_FIRESTORE_EMULATOR_PORT="8080"

# Backend operator credentials are configured only through protected deployment
# and connector secret fields. Never place their values in this file.
# BACKEND_OPERATOR_TOKEN is the protected variable name used for diagnostics.
