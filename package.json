{
  "name": "rq",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "scripts": {
    "dev": "RQ_API_RUNTIME=hono tsx server.ts",
    "dev:express": "tsx server.ts",
    "dev:hono": "RQ_API_RUNTIME=hono tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:cloudflare": "node tools/build-cloudflare.mjs",
    "build": "vite build && npm run build:server && npm run build:cloudflare && cp -r dist build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist build",
    "test": "vitest run",
    "test:e2e:preview": "playwright test --config=playwright.preview.config.ts",
    "lint": "tsc --noEmit",
    "ci:check": "tsx tools/ci-check.ts",
    "benchmark": "tsx tools/performance-benchmark.ts",
    "release:smoke": "tsx tools/release-smoke.ts",
    "maintainability:check": "tsx tools/maintainability-check.ts",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-rq-unified-hono \"node tools/firestore-rules-supervisor.test.mjs\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.3.0",
    "hono": "^4.13.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@csstools/postcss-color-mix-function": "^4.0.11",
    "@csstools/postcss-oklab-function": "^5.0.11",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
