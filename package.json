{
  "name": "rq",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:cloudflare": "node tools/build-cloudflare.mjs",
    "build": "vite build && npm run build:cloudflare && cp -r dist build",
    "clean": "rm -rf dist build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "ci:check": "tsx tools/ci-check.ts",
    "benchmark": "tsx tools/performance-benchmark.ts",
    "financial-report:benchmark": "tsx tools/financial-report-benchmark.ts",
    "firestore-pagination:benchmark": "tsx tools/firestore-pagination-benchmark.ts",
    "release:smoke": "tsx tools/release-smoke.ts",
    "smoke:worker-artifact": "node tools/worker-artifact-smoke.mjs",
    "maintainability:check": "tsx tools/maintainability-check.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rq-unified-hono \"node tools/firestore-rules-security.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@csstools/postcss-color-mix-function": "^4.0.11",
    "@csstools/postcss-oklab-function": "^5.0.11",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "firebase-tools": "15.34.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@6.2.3": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.7"
    }
  }
}
