{
  "name": "rq",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:cloudrun": "esbuild server/cloudRun.ts --bundle --platform=node --format=cjs --packages=bundle --sourcemap --outfile=dist/cloud-run.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/cloudRun.ts --bundle --platform=node --format=cjs --packages=bundle --sourcemap --outfile=dist/cloud-run.cjs && esbuild serverless/api-entry.ts --bundle --platform=node --format=cjs --packages=bundle --outfile=api/index.js",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "ci:check": "tsx tools/ci-check.ts"
  },
  "dependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.11",
    "@csstools/postcss-oklab-function": "^5.0.11",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "postcss-preset-env": "^11.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.51.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-legacy": "^8.2.3",
    "autoprefixer": "^10.5.6",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.28",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
